# Heartland Network — environment template
# Copy this file to .env and fill in values before `docker compose up -d`.

# --- Database credentials (REQUIRED — set a strong password) ---
POSTGRES_USER=heartland
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=heartland

# --- Application ---
# Host port to reach the game on your LAN.
HEARTLAND_PORT=8080

# Override the image (defaults to the pinned immutable release):
#   ghcr.io/atvriders/heartland-network:1.0.0
# To deliberately track the latest release instead, set:
#   HEARTLAND_IMAGE=ghcr.io/atvriders/heartland-network:latest
# HEARTLAND_IMAGE=

# Milliseconds per game day at 1x speed (default 1000 = 1 day/second).
TICK_MS=1000

# Maximum number of saved games kept in the database.
MAX_GAMES=12

# Optional: if set, admin-only actions (import/delete) require this header:
#   X-Admin-Token: <token>
ADMIN_TOKEN=
